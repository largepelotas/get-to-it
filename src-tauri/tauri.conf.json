{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Checklist",
  "version": "../package.json",
  "identifier": "com.largepelotas.checklist",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Checklist",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "To-do lists, grocery lists and notes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "To-do lists with subtasks, due dates, repeats and reminders, grocery lists sorted by category, and rich-text notes. Everything is stored on this computer.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/uninstaller.ico"
      }
    }
  }
}
